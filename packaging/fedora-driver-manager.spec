Name:           fedora-driver-manager
Version:        0.1.3
Release:        %autorelease
Summary:        Hardware driver, firmware, and rollback manager for Fedora
License:        GPL-3.0-or-later AND Apache-2.0 AND (Apache-2.0 WITH LLVM-exception) AND MIT AND MPL-2.0 AND Unlicense
URL:            https://github.com/shridhargsabat/fedora-driver-manager
Source:         %{url}/archive/v%{version}/%{name}-%{version}.tar.gz
# Vendor tarball of crates.io deps, generated by the packager (see packaging/README-vendor.md)
Source1:        %{name}-%{version}-vendor.tar.gz

BuildRequires:  cargo-rpm-macros >= 25
BuildRequires:  pkgconfig(gtk4)
BuildRequires:  pkgconfig(libadwaita-1)
BuildRequires:  desktop-file-utils
BuildRequires:  appstream
Requires:       hicolor-icon-theme
# The app shells out to these host tools (src/backend/*.rs):
Requires:       pciutils
Requires:       usbutils
Requires:       fwupd
Requires:       dnf5
Requires:       mokutil
Requires:       polkit

%description
Driver Manager detects your hardware — graphics, Wi-Fi, audio, storage,
and peripherals — shows which kernel drivers are in use, and recommends
the right driver packages for Fedora Workstation. It also surfaces
firmware updates via fwupd, reports Secure Boot status, and lets you
review and roll back recent software transactions safely.

%prep
%autosetup -p1 -a1
%cargo_prep -v vendor

%build
%cargo_build
%{cargo_license_summary}
%{cargo_license} > LICENSE.dependencies
%{cargo_vendor_manifest}

%install
install -Dpm0755 target/rpm/%{name} -t %{buildroot}%{_bindir}
install -Dpm0644 data/io.github.shridhargsabat.DriverManager.desktop -t %{buildroot}%{_datadir}/applications
install -Dpm0644 data/io.github.shridhargsabat.DriverManager.metainfo.xml -t %{buildroot}%{_datadir}/metainfo
install -Dpm0644 data/io.github.shridhargsabat.DriverManager.svg -t %{buildroot}%{_datadir}/icons/hicolor/scalable/apps
install -Dpm0644 data/io.github.shridhargsabat.DriverManager.policy -t %{buildroot}%{_datadir}/polkit-1/actions
install -Dpm0644 data/io.github.shridhargsabat.DriverManager.service -t %{buildroot}%{_datadir}/dbus-1/services

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/io.github.shridhargsabat.DriverManager.desktop
appstreamcli validate --no-net %{buildroot}%{_datadir}/metainfo/io.github.shridhargsabat.DriverManager.metainfo.xml

%files
%license LICENSE
%license LICENSE.dependencies
%license cargo-vendor.txt
%doc README.md
%{_bindir}/%{name}
%{_datadir}/applications/io.github.shridhargsabat.DriverManager.desktop
%{_datadir}/metainfo/io.github.shridhargsabat.DriverManager.metainfo.xml
%{_datadir}/icons/hicolor/scalable/apps/io.github.shridhargsabat.DriverManager.svg
%{_datadir}/polkit-1/actions/io.github.shridhargsabat.DriverManager.policy
%{_datadir}/dbus-1/services/io.github.shridhargsabat.DriverManager.service

%changelog
%autochangelog
